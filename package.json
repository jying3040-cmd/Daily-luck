{
  "name": "daily-fortune",
  "private": true,
  "version": "0.1.0",
  "description": "个人每日运势本地应用",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "test": "npm run test --workspace server",
    "verify": "npm run verify --workspace server",
    "check": "npm run test && npm run build && npm run verify"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "license": "MIT"
}
